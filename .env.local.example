# Copy this file to .env.local and fill in both values (Supabase > Project Settings > API).
# The anon key is meant to be public. NEVER put a "service_role" key in this project's front end.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=PASTE_YOUR_ANON_KEY_HERE
